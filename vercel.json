{
  "rewrites": [
    {
      "source": "/invoice",
      "destination": "/invoice.html"
    },
    {
      "source": "/clients",
      "destination": "/clients.html"
    },
    {
      "source": "/files",
      "destination": "/files.html"
    },
    {
      "source": "/trip-report",
      "destination": "/trip-report.html"
    },
    {
      "source": "/contract",
      "destination": "/contract.html"
    },
    {
      "source": "/rateconfirmation",
      "destination": "/rateconfirmation.html"
    },
    {
      "source": "/staff",
      "destination": "/staff.html"
    },
    {
      "source": "/staff-cargo",
      "destination": "/staff-cargo.html"
    },
    {
      "source": "/staff-dashboard",
      "destination": "/staff-dashboard.html"
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}